@{
    ViewBag.Title = "Application Tracking";
}
@* SME Finance Application - Tracking (Phase 8): a dedicated URL into the existing, unmodified
   Application Tracking page (js/pages/sme/applicationTracking.js) at #/sme/tracking/{id} inside
   the persistent Dashboard shell. Phase 8 rewired that page from its previous fully-hardcoded
   mock timeline to render the real application + real ApplicationStatusHistory rows - see that
   file's own comments - but its HTML structure/classes/animation are untouched. The {id} is
   read client-side from window.location.pathname, same approach as Details.cshtml above. *@
@section scripts {
    <script type="module" src="@Url.Content("~/Scripts/js/bootstrap/applicationTrackingPage.js")"></script>
}
